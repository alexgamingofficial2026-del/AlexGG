local function CreateSkeleton(player)
    if player == LocalPlayer then return end
    local lines = {}
    for i = 1, 15 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1.5
        line.Color = Color3.fromRGB(144, 238, 144)
        line.Transparency = 0.2
        table.insert(lines, line)
    end
    skeletons[player] = lines
end

local function RemoveSkeleton(player)
    if skeletons[player] then
        for _, line in pairs(skeletons[player]) do line:Remove() end
        skeletons[player] = nil
    end
end

local originalSizes = {}

local function ExpandHead(player)
    if player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    if not originalSizes[player] then
        originalSizes[player] = head.Size
    end

    if Settings.Headshot100 then
        head.Size = Vector3.new(6, 6, 6)
        head.Transparency = 1
        head.CanCollide = false
        head.Material = Enum.Material.Plastic

        if head:FindFirstChild("HitboxHL") then
            head.HitboxHL:Destroy()
        end

    elseif Settings.HitboxExpander then
        local size = Settings.HitboxSize
        head.Size = Vector3.new(size, size, size)
        head.Transparency = 0.55
        head.CanCollide = false
        head.Material = Enum.Material.ForceField

        if not head:FindFirstChild("HitboxHL") then
            local hl = Instance.new("Highlight")
            hl.Name = "HitboxHL"
            hl.FillColor = Settings.HitboxColor
            hl.OutlineColor = Settings.HitboxColor
            hl.FillTransparency = 0.4
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = head
        else
            head.HitboxHL.FillColor = Settings.HitboxColor
            head.HitboxHL.OutlineColor = Settings.HitboxColor
        end
    end
end

local function RestoreHead(player)
    local character = player.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    if originalSizes[player] then
        head.Size = originalSizes[player]
        head.Transparency = 0
        head.Material = Enum.Material.Plastic
    end
    if head:FindFirstChild("HitboxHL") then
        head.HitboxHL:Destroy()
    end
end

