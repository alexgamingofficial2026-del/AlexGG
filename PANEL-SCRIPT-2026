local function ApplyGreenChams(character)
    if not character then return end
    if character:FindFirstChild("PlayerChams") then character.PlayerChams:Destroy() end
    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerChams"
    highlight.FillColor = Color3.fromRGB(144, 238, 144)
    highlight.OutlineColor = Color3.fromRGB(50, 205, 50)
    highlight.FillTransparency = 0.25
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
end

local function RemoveGreenChams(character)
    if character and character:FindFirstChild("PlayerChams") then
        character.PlayerChams:Destroy()
    end
end

local function ApplyBlueArms(character)
    if not character then return end
    if character:FindFirstChild("BlueArmsChams") then character.BlueArmsChams:Destroy() end
    local arms = {"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "Left Arm", "Right Arm"}
    local folder = Instance.new("Folder")
    folder.Name = "BlueArmsChams"
    folder.Parent = character
    for _, armName in ipairs(arms) do
        local part = character:FindFirstChild(armName)
        if part then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(100, 180, 255)
            hl.OutlineColor = Color3.fromRGB(0, 120, 255)
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = part
            hl.Parent = folder
        end
    end
end

local function RemoveBlueArms(character)
    if character and character:FindFirstChild("BlueArmsChams") then
        character.BlueArmsChams:Destroy()
    end
end

local tracers = {}
local function CreateTracer(player)
    if player == LocalPlayer then return end
    local attachment0 = Instance.new("Attachment")
    local attachment1 = Instance.new("Attachment")
    local beam = Instance.new("Beam")
    beam.Name = "NeonTracer"
    beam.Attachment0 = attachment0
    beam.Attachment1 = attachment1
    beam.Color = ColorSequence.new(Color3.fromRGB(144, 238, 144))
    beam.Width0 = 0.15
    beam.Width1 = 0.15
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Transparency = NumberSequence.new(0.1)
    beam.Segments = 10
    tracers[player] = {Beam = beam, Att0 = attachment0, Att1 = attachment1}
end

local function RemoveTracer(player)
    if tracers[player] then
        tracers[player].Beam:Destroy()
        tracers[player].Att0:Destroy()
        tracers[player].Att1:Destroy()
        tracers[player] = nil
    end
end

