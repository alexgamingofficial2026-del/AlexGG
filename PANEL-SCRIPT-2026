local function SetupPlayer(player)
    if player == LocalPlayer then return end
    CreateTracer(player)
    CreateSkeleton(player)

    if player.Character then
        if Settings.GreenHologram then ApplyGreenChams(player.Character) end
        if Settings.BlueArms then ApplyBlueArms(player.Character) end
        if Settings.Headshot100 or Settings.HitboxExpander then ExpandHead(player) end
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(0.4)
        if Settings.GreenHologram then ApplyGreenChams(char) end
        if Settings.BlueArms then ApplyBlueArms(char) end
        if Settings.Headshot100 or Settings.HitboxExpander then ExpandHead(player) end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do SetupPlayer(player) end
Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(function(player)
    RemoveTracer(player)
    RemoveSkeleton(player)
    originalSizes[player] = nil
end)

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Settings.GreenHologram then
                if not player.Character:FindFirstChild("PlayerChams") then ApplyGreenChams(player.Character) end
            else
                RemoveGreenChams(player.Character)
            end

            if Settings.BlueArms then
                if not player.Character:FindFirstChild("BlueArmsChams") then ApplyBlueArms(player.Character) end
            else
                RemoveBlueArms(player.Character)
            end

            if Settings.Headshot100 or Settings.HitboxExpander then
                ExpandHead(player)
            else
                RestoreHead(player)
            end
        end
    end

    -- Lines
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for player, data in pairs(tracers) do
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if Settings.Lines and myRoot and root then
            data.Att0.Parent = myRoot
            data.Att1.Parent = root
            data.Beam.Parent = myRoot
            data.Beam.Enabled = true
        else
            data.Beam.Enabled = false
        end
    end

    -- Skeleton
    for player, lines in pairs(skeletons) do
        local character = player.Character
        if not character or not Settings.Skeleton then
            for _, line in pairs(lines) do line.Visible = false end
            continue
        end

        local isR15 = character:FindFirstChild("UpperTorso") ~= nil
        local boneList = isR15 and bonesR15 or bonesR6

        for i, bonePair in ipairs(boneList) do
            local part1 = character:FindFirstChild(bonePair[1])
            local part2 = character:FindFirstChild(bonePair[2])
            local line = lines[i]

            if part1 and part2 and line then
                local pos1, onScreen1 = Camera:WorldToViewportPoint(part1.Position)
                local pos2, onScreen2 = Camera:WorldToViewportPoint(part2.Position)
                if onScreen1 or onScreen2 then
                    line.From = Vector2.new(pos1.X, pos1.Y)
                    line.To = Vector2.new(pos2.X, pos2.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            elseif line then
                line.Visible = false
            end
        end
        for i = #boneList + 1, #lines do lines[i].Visible = false end
    end

    -- Aim Assist Crosshair
    if Settings.AimAssist then
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        crosshair.Position = center
        crosshair.Color = Settings.CrosshairColor
        crosshair.Visible = true

        crosshair2.From = Vector2.new(center.X - 10, center.Y)
        crosshair2.To = Vector2.new(center.X + 10, center.Y)
        crosshair2.Color = Settings.CrosshairColor
        crosshair2.Visible = true

        crosshair3.From = Vector2.new(center.X, center.Y - 10)
        crosshair3.To = Vector2.new(center.X, center.Y + 10)
        crosshair3.Color = Settings.CrosshairColor
        crosshair3.Visible = true
    else
        crosshair.Visible = false
        crosshair2.Visible = false
        crosshair3.Visible = false
    end
end)

-- Aimbot
local function GetClosestHead()
    local closest, shortest = nil, Settings.AimbotFOV
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character.Humanoid and player.Character.Humanoid.Health > 0 then
            if Settings.TeamCheck and player.Team == LocalPlayer.Team then continue end
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                local dist = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = player.Character.Head
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if Settings.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = GetClosestHead()
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), Settings.AimbotSmooth)
        end
    end
end)

-- Speed & Jump
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if Settings.Speed then
        hum.WalkSpeed = Settings.SpeedValue
    else
        hum.WalkSpeed = 16
    end

    if Settings.JumpPower then
        hum.JumpPower = Settings.JumpValue
        hum.JumpHeight = Settings.JumpValue / 7.2
    else
        hum.JumpPower = 50
    end
end)

